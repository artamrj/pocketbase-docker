#!/bin/sh
set -eu

root=${POCKETBASE_MIGRATIONS_DIR:-/pocketbase/migrations}
releases=$root/releases
current=$root/current
expected=${MIGRATIONS_SHA256:-}
commit=${MIGRATIONS_COMMIT:-}
subdir=${MIGRATIONS_SUBDIR:-pb_migrations}
token_file=${MIGRATIONS_TOKEN_FILE:-/run/secrets/github_token}

die() {
  echo "migration-worker: $*" >&2
  exit 1
}

require_embedded_values() {
  [ -n "$expected" ] || die "MIGRATIONS_SHA256 is not embedded"
  [ "${#expected}" -eq 64 ] || die "embedded migration hash is not a full SHA-256"
  case "$expected" in *[!0-9a-f]*) die "embedded migration hash is invalid" ;; esac
  [ -n "$commit" ] || die "MIGRATIONS_COMMIT is not embedded"
  case "$commit" in *[!0-9a-f]*) die "embedded migration commit is invalid" ;; esac
  [ "${#commit}" -eq 40 ] || [ "${#commit}" -eq 64 ] \
    || die "embedded migration commit is not a full object ID"
}

active_hash() {
  [ -L "$current" ] || return 1
  basename "$(readlink "$current")"
}

verify_dir() {
  candidate=$1
  [ -d "$candidate" ] || die "bundle is missing: $candidate"
  actual=$(migration-hash "$candidate")
  [ "$actual" = "$expected" ] || die "migration checksum mismatch: expected $expected, got $actual"
}

status() {
  require_embedded_values
  active=$(active_hash 2>/dev/null || true)
  if [ -z "$active" ]; then
    echo "active=none"
  else
    echo "active=$active"
  fi
  echo "embedded=$expected"
  echo "commit=$commit"
  [ "$active" = "$expected" ] || exit 1
}

verify() {
  require_embedded_values
  active=$(active_hash 2>/dev/null || true)
  [ "$active" = "$expected" ] || die "active bundle does not match embedded hash"
  verify_dir "$releases/$expected"
  echo "$expected"
}

validate_archive_paths() {
  archive=$1
  if ! tar -tvzf "$archive" | awk 'substr($0, 1, 1) != "-" && substr($0, 1, 1) != "d" { exit 1 }'; then
    die "archive contains links or special entries"
  fi
  tar -tzf "$archive" | while IFS= read -r item; do
    case "/$item/" in
      *"/../"*|"//"*|*"//"*) die "unsafe archive path: $item" ;;
    esac
  done
}

sync_bundle() {
  require_embedded_values
  url=${MIGRATIONS_URL:-}
  [ -n "$url" ] || die "MIGRATIONS_URL is required"
  [ -r "$token_file" ] || die "migration token is missing or unreadable: $token_file"
  token=$(tr -d '\r\n' < "$token_file")
  [ -n "$token" ] || die "migration token is empty"

  mkdir -p "$root" "$releases"
  work=$(mktemp -d "$root/.sync.XXXXXXXX")
  trap 'rm -rf "$work"' EXIT HUP INT TERM
  archive=$work/repository.tar.gz

  curl --fail --silent --show-error --location \
    --proto '=https' --tlsv1.2 \
    --header "Authorization: Bearer $token" \
    --header 'Accept: application/vnd.github+json' \
    --header 'X-GitHub-Api-Version: 2022-11-28' \
    --output "$archive" "${url%/}/$commit" \
    || die "could not download pinned migration archive"

  validate_archive_paths "$archive"
  mkdir "$work/extracted"
  tar -xzf "$archive" -C "$work/extracted"

  source_dir=$(find "$work/extracted" -type d -path "*/$subdir" -print)
  source_count=$(printf '%s\n' "$source_dir" | sed '/^$/d' | wc -l | tr -d ' ')
  [ "$source_count" -eq 1 ] || die "expected one $subdir directory in archive, found $source_count"
  verify_dir "$source_dir"

  destination=$releases/$expected
  if [ -e "$destination" ]; then
    verify_dir "$destination"
  else
    staging=$work/bundle
    mkdir "$staging"
    cp -a "$source_dir"/. "$staging"/
    verify_dir "$staging"
    mv "$staging" "$destination"
  fi

  link_tmp=$work/current-link
  ln -s "releases/$expected" "$link_tmp"
  mv -Tf "$link_tmp" "$current"
  trap - EXIT HUP INT TERM
  rm -rf "$work"
  echo "$expected"
}

gc_bundles() {
  require_embedded_values
  mkdir -p "$releases"
  active=$(active_hash 2>/dev/null || true)
  find "$releases" -mindepth 1 -maxdepth 1 -type d -print0 \
    | while IFS= read -r -d '' bundle; do
        hash=$(basename "$bundle")
        if [ "$hash" = "$active" ]; then
          continue
        fi
        [ "${#hash}" -eq 64 ] || continue
        case "$hash" in *[!0-9a-f]*) continue ;; esac
        rm -rf -- "$bundle"
      done
}

case "${1:-}" in
  status) status ;;
  sync) sync_bundle ;;
  verify) verify ;;
  gc) gc_bundles ;;
  *) echo "usage: migration-worker {status|sync|verify|gc}" >&2; exit 64 ;;
esac
