#!/bin/sh
set -eu

root=${POCKETBASE_MIGRATIONS_DIR:-/pocketbase/migrations}
release=$root/release
current=$root/current
repo=${MIGRATIONS_REPOSITORY:-artamrj/pocketbase-migrations}
branch=${MIGRATIONS_BRANCH:-main}
token_file=${MIGRATIONS_TOKEN_FILE:-/run/secrets/github_token}
url=${MIGRATIONS_URL:-"https://api.github.com/repos/$repo/tarball/$branch"}

die() {
  echo "migration-worker: $*" >&2
  exit 1
}

require_token() {
  token=${MIGRATIONS_TOKEN:-}
  if [ -z "$token" ]; then
    [ -r "$token_file" ] || die "migration token is missing (set MIGRATIONS_TOKEN or provide $token_file)"
    token=$(tr -d '\r\n' < "$token_file")
  fi
  [ -n "$token" ] || die "migration token is empty"
}

validate_migrations() {
  directory=$1
  files=$(find "$directory" -mindepth 1 -maxdepth 1 -type f -name '*.js' -print)
  [ -n "$files" ] || die "no migration files in $directory"
  nested=$(find "$directory" -mindepth 2 -name '*.js' -print -quit)
  [ -z "$nested" ] || die "migration files must not be nested: $nested"
  invalid=$(printf '%s\n' "$files" | while IFS= read -r file; do
    basename "$file" | grep -Eq '^[0-9]{14}_[a-z0-9][a-z0-9_-]*\.js$' || echo "$file"
  done)
  [ -z "$invalid" ] || die "invalid migration filenames: $invalid"
}

sync() {
  require_token
  mkdir -p "$root"
  work=$(mktemp -d "$root/.sync.XXXXXXXX")
  trap 'rm -rf "$work"' EXIT HUP INT TERM
  archive=$work/repository.tar.gz

  curl --fail --silent --show-error --location \
    --proto '=https' --tlsv1.2 \
    --header "Authorization: Bearer $token" \
    --header 'Accept: application/vnd.github+json' \
    --header 'X-GitHub-Api-Version: 2022-11-28' \
    --output "$archive" "$url" \
    || die "could not download $repo migrations"

  mkdir "$work/extracted"
  tar -xzf "$archive" -C "$work/extracted"
  root_dirs=$(find "$work/extracted" -mindepth 1 -maxdepth 1 -type d -print)
  root_count=$(printf '%s\n' "$root_dirs" | sed '/^$/d' | wc -l | tr -d ' ')
  [ "$root_count" -eq 1 ] || die "expected one top-level directory in archive, found $root_count"
  repo_root=$(printf '%s\n' "$root_dirs" | head -n1)
  if [ -d "$repo_root/pb_migrations" ]; then
    source_dir=$repo_root/pb_migrations
  else
    source_dir=$repo_root
  fi
  validate_migrations "$source_dir"

  staged="$work/staged"
  mkdir "$staged"
  cp -a "$source_dir"/. "$staged"/
  rm -rf "$release"
  mv "$staged" "$release"
  ln -sfn release "$current"

  trap - EXIT HUP INT TERM
  rm -rf "$work"
  echo "migrations synced to $current"
}

status() {
  if [ -L "$current" ] && [ -d "$release" ]; then
    echo "current=$release"
    find "$release" -mindepth 1 -maxdepth 1 -type f | sort | xargs -n1 basename
  else
    echo "current=none (run: migration-worker sync)"
  fi
}

case "${1:-}" in
  sync) sync ;;
  status) status ;;
  *) echo "usage: migration-worker {sync|status}" >&2; exit 64 ;;
esac
