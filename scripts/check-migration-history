#!/bin/sh
set -eu

if [ "$#" -ne 3 ]; then
  echo "usage: check-migration-history REPOSITORY MIGRATIONS_SUBDIR BASELINE_COMMIT" >&2
  exit 64
fi

repository=$1
subdir=${2%/}
baseline=$3

git -C "$repository" cat-file -e "$baseline^{commit}" 2>/dev/null \
  || { echo "migration policy baseline is not a fetched commit: $baseline" >&2; exit 65; }

violations=
for revision in $(git -C "$repository" rev-list --reverse "$baseline..HEAD"); do
  changed=$(git -C "$repository" diff-tree --no-commit-id --name-status -r -m -M \
    --diff-filter=MDRT "$revision" -- "$subdir")
  if [ -n "$changed" ]; then
    violations="${violations}${revision}\n${changed}\n"
  fi
done

[ -z "$violations" ] || {
  echo "deployed migrations are immutable; forbidden history changes:" >&2
  printf '%b' "$violations" >&2
  exit 65
}
