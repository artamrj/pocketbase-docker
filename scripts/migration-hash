#!/bin/sh
set -eu

if [ "$#" -ne 1 ] || [ ! -d "$1" ]; then
  echo "usage: migration-hash DIRECTORY" >&2
  exit 64
fi

directory=${1%/}
nested=$(find "$directory" -mindepth 2 -type f -name '*.js' -print -quit)
[ -z "$nested" ] || {
  echo "migration files must be top-level: $nested" >&2
  exit 65
}
unsupported=$(find "$directory" ! -type d ! -type f -print -quit)
[ -z "$unsupported" ] || {
  echo "migration directory contains a non-regular entry: $unsupported" >&2
  exit 65
}
file_count=$(find "$directory" -maxdepth 1 -type f -name '*.js' -print | wc -l | tr -d ' ')
if [ "$file_count" -eq 0 ]; then
  echo "migration directory contains no files: $directory" >&2
  exit 65
fi

# LC_ALL=C and NUL delimiters make this stable across hosts and unusual paths.
# Separate stages ensure an upstream failure cannot be hidden by a later pipe.
work=$(mktemp -d "${TMPDIR:-/tmp}/migration-hash.XXXXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
LC_ALL=C find "$directory" -maxdepth 1 -type f -name '*.js' -print0 > "$work/paths"
LC_ALL=C sort -z "$work/paths" > "$work/sorted"
xargs -0 sh -c '
      set -eu
      directory=$1
      shift
      for file do
        relative=${file#"$directory"/}
        size=$(wc -c < "$file" | tr -d " ")
        printf "%s\0%s\0" "$relative" "$size"
        dd if="$file" bs=65536 2>/dev/null
        printf "\0"
      done
    ' sh "$directory" < "$work/sorted" > "$work/stream"
digest=$(sha256sum "$work/stream")
printf '%s\n' "${digest%% *}"
