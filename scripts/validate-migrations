#!/bin/sh
set -eu

if [ "$#" -ne 1 ] || [ ! -d "$1" ]; then
  echo "usage: validate-migrations DIRECTORY" >&2
  exit 64
fi

directory=${1%/}
files=$(find "$directory" -mindepth 1 -maxdepth 1 -type f -print)
[ -n "$files" ] || {
  echo "migration directory contains no migration files: $directory" >&2
  exit 65
}

nested=$(find "$directory" -mindepth 2 -print -quit)
[ -z "$nested" ] || {
  echo "migration files must not be nested: $nested" >&2
  exit 65
}

invalid=0
while IFS= read -r file; do
  name=$(basename "$file")
  if ! printf '%s\n' "$name" | grep -Eq '^[0-9]{14}_[a-z0-9][a-z0-9_-]*\.js$'; then
    echo "invalid immutable migration filename: $name" >&2
    invalid=1
  fi
done <<EOF
$files
EOF
[ "$invalid" -eq 0 ] || exit 65

duplicates=$(printf '%s\n' "$files" \
  | while IFS= read -r file; do basename "$file" | cut -c 1-14; done \
  | sort | uniq -d)
[ -z "$duplicates" ] || {
  echo "duplicate migration timestamps:" >&2
  echo "$duplicates" >&2
  exit 65
}
